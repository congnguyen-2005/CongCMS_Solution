@model IEnumerable<CMS.data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark">DANH SÁCH BÀI VIẾT</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <span class="badge bg-info text-dark mb-2">@item.Category?.Name</span>
                            <h5 class="card-title text-primary">@item.Title</h5>
                            <p class="card-text text-truncate">@Html.Raw(item.Content)</p>

                            <hr />
                            <div class="d-flex justify-content-between">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm" title="Xem">Chi tiết</a>
                                <div>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn chắc chắn muốn xóa bài viết này?')">Xóa</a>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-muted small">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info w-100 text-center">Chưa có bài viết nào!</div>
        }
    </div>
</div>