@model IEnumerable<CMS.data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">
    <h3 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h3>
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover; background-color: #f8f9fa;">

                        <div class="card-body">
                            <span class="badge bg-info text-dark mb-2">@item.Category.Name</span>

                            <h5 class="card-title text-primary">@item.Title</h5>

                            <p class="card-text text-truncate">@item.Content</p>

                            <p class="text-muted small">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>

                            <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Chưa có bài viết nào!</div>
            </div>
        }
    </div>
</div>