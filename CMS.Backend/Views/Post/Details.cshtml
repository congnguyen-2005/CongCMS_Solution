@* Chú ý: Lần này Model chỉ là 1 đối tượng Post (không có IEnumerable) vì ta chỉ xem 1 bài *@
@model CMS.data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
}
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Danh mục sản phẩm";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a href="/Post" class="btn btn-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>

            <div class="card shadow">
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;">

                <div class="card-body p-5">
                    <span class="badge bg-info text-dark mb-3">@Model.Category.Name</span>

                    <h2 class="card-title text-primary mb-3">@Model.Title</h2>

                    <p class="text-muted small mb-4">
                        <i class="far fa-calendar-alt"></i> Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
                    </p>

                    <div class="card-text" style="font-size: 1.1rem; line-height: 1.6;">
                        @Model.Content
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>