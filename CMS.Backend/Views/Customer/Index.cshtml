@model IEnumerable<CMS.data.Entities.Customer>
@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<h3 class="text-info mb-3">DANH SÁCH KHÁCH HÀNG</h3>
<table class="table table-bordered table-striped shadow-sm">
    <thead class="bg-info text-white">
        <tr>
            <th>ID</th>
            <th>Tên khách hàng</th>
            <th>Email</th>
            <th>Số điện thoại</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Fullname</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4" class="text-center">Chưa có khách hàng nào.</td></tr>
        }
    </tbody>
</table>