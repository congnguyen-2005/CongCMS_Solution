@model CMS.data.Entities.Customer
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Thêm khách hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white"><h5 class="mb-0">THÊM KHÁCH HÀNG MỚI</h5></div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Họ và Tên:</label>
                        <input asp-for="Fullname" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Số điện thoại:</label>
                        <input asp-for="Phone" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Email:</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>
                <hr />
                <button type="submit" class="btn btn-primary">Lưu khách hàng</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</div>