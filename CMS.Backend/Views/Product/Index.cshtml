@model IEnumerable<CMS.data.Entities.Product>
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-dark fw-bold">DANH SÁCH SẢN PHẨM</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" alt="SP">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.CategoryProduct?.Name</span>
                        <h6 class="fw-bold">@item.Name</h6>
                        <p class="text-danger fw-bold">@string.Format("{0:#,##0} VNĐ", item.Price)</p>
                    </div>
                    <div class="card-footer bg-white text-center border-top-0">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-45">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-45" onclick="return confirm('Chắc chắn xóa?')">Xóa</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>