@model CMS.data.Entities.Product
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            <i class="bi bi-pencil-square"></i> CHỈNH SỬA THÔNG TIN SẢN PHẨM
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryProductId" class="form-label fw-bold">Danh mục sản phẩm</label>
                        <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryList">
                            <option value="">-- Chọn danh mục sản phẩm --</option>
                        </select>
                        <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" class="form-control" placeholder="Ví dụ: 150000" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="Ví dụ: 50" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết về tính năng, thông số sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row align-items-center mb-4">
                    <div class="col-md-8 mb-3">
                        <label class="form-label fw-bold">Thay đổi ảnh minh họa sản phẩm</label>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <div class="form-text text-muted">Bỏ trống nếu muốn giữ nguyên ảnh hiện tại.</div>
                    </div>
                    <div class="col-md-4 text-center">
                        <label class="d-block form-label fw-bold mb-2">Ảnh hiện tại</label>
                        <img src="@Model.ImageUrl" class="img-thumbnail rounded shadow-sm" style="max-height: 130px; object-fit: cover;" alt="Product Image">
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                        <i class="bi bi-save"></i> Lưu các thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>