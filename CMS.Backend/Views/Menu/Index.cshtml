@model IEnumerable<CMS.data.Entities.Menu>

@{
    Layout = "_LayoutAdmin";

    ViewData["Title"] = "Quản lý Menu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-dark">Quản lý Menu Header</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus mr-1"></i> Thêm Menu Mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0">Tên Hiển Thị</th>
                        <th class="border-0">Đường Dẫn (URL)</th>
                        <th class="border-0 text-center">Menu Cha</th>
                        <th class="border-0 text-center">Thứ Tự</th>
                        <th class="border-0 text-center">Trạng Thái</th>
                        <th class="border-0 text-right pr-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu Menu nào trong hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">#@item.Id</td>
                                <td class="align-middle">@item.Name</td>
                                <td class="align-middle"><code class="text-info">@item.LinkUrl</code></td>
                                <td class="align-middle text-center">
                                    @(item.ParentId.HasValue ? $"#{@item.ParentId}" : "-")
                                </td>
                                <td class="align-middle text-center">@item.DisplayOrder</td>
                                <td class="align-middle text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success px-2 py-1">Đang hiện</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1">Đang ẩn</span>
                                    }
                                </td>
                                <td class="align-middle text-right pr-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mr-1">
                                        <i class="fa-solid fa-pen"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa menu này không?');">
                                        <i class="fa-solid fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>