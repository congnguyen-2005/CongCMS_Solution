@model IEnumerable<CMS.data.Entities.OrderDetail>
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Chi tiết Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-dark fw-bold">CHI TIẾT ĐƠN HÀNG #@ViewBag.OrderId</h4>
        <a href="/Order/Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại Đơn hàng</a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-bordered mb-0 text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh Sản phẩm</th>
                    <th>Tên Sản phẩm</th>
                    <th>Đơn giá (Lúc mua)</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    decimal totalOrder = 0;
                    foreach (var item in Model)
                    {
                        var subTotal = item.UnitPrice * item.Quantity;
                        totalOrder += subTotal;
                        <tr>
                            <td style="width: 100px;">
                                <img src="@item.Product?.ImageUrl" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" />
                            </td>
                            <td class="fw-bold text-start">@item.Product?.Name</td>
                            <td>@string.Format("{0:#,##0} VNĐ", item.UnitPrice)</td>
                            <td><span class="badge bg-primary fs-6">@item.Quantity</span></td>
                            <td class="text-danger fw-bold">@string.Format("{0:#,##0} VNĐ", subTotal)</td>
                        </tr>
                    }
                    <tr class="table-warning font-weight-bold">
                        <td colspan="4" class="text-end">TỔNG CỘNG ĐƠN HÀNG:</td>
                        <td class="text-danger fs-5 fw-bold">@string.Format("{0:#,##0} VNĐ", totalOrder)</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="5" class="text-muted py-4">Đơn hàng này chưa có sản phẩm nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>