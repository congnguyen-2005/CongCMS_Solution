@model CMS.data.Entities.CategoryProduct
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Thêm danh mục SP";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white"><h5 class="mb-0">THÊM DANH MỤC SẢN PHẨM</h5></div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="fw-bold">Mô tả chi tiết:</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Lưu dữ liệu</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>