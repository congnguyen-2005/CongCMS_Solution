@model CMS.data.Entities.Banner

@{
    Layout = "_LayoutAdmin";

    ViewData["Title"] = "Thêm Banner";
}

<div class="mb-4">
    <h2 class="font-weight-bold text-dark">Thêm Banner Mới</h2>
    <p class="text-muted">Tải lên hình ảnh quảng cáo khổ lớn cho trang chủ (Khuyên dùng ảnh 1920x600px).</p>
</div>

<div class="card shadow-sm border-0 col-md-8 mx-auto">
    <div class="card-body p-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-4">
                <label class="font-weight-bold">Tải lên hình ảnh <span class="text-danger">*</span></label>
                <div class="custom-file">
                    <input type="file" name="uploadImage" class="custom-file-input" id="customFile" accept="image/*" required>
                    <label class="custom-file-label" for="customFile">Chọn file ảnh từ máy tính...</label>
                </div>
            </div>

            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="Title" class="font-weight-bold">Tiêu đề (Câu Slogan) <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="VD: Kỷ nguyên nhiếp ảnh..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="TargetUrl" class="font-weight-bold">Link khi click vào ảnh</label>
                    <input asp-for="TargetUrl" class="form-control" placeholder="VD: /shop/sony-a7iv" />
                    <span asp-validation-for="TargetUrl" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="DisplayOrder" class="font-weight-bold">Thứ tự hiển thị (Slide số mấy)</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" value="1" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group form-check mt-2 mb-4">
                <input class="form-check-input" asp-for="IsActive" checked />
                <label class="form-check-label font-weight-bold cursor-pointer" asp-for="IsActive">
                    Bật hiển thị trên trang chủ
                </label>
            </div>

            <hr />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-upload mr-1"></i> Lưu & Tải ảnh lên
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Script nhỏ giúp hiển thị tên file khi người dùng chọn ảnh
        $(".custom-file-input").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
}