@model IEnumerable<CMS.data.Entities.Order>
@{
    ViewData["Title"] = "Danh sách Đơn hàng";
}

<h3 class="text-warning mb-3">DANH SÁCH ĐƠN HÀNG</h3>
<table class="table table-bordered table-striped shadow-sm">
    <thead class="bg-warning text-dark">
        <tr>
            <th>Mã đơn (ID)</th>
            <th>Ngày đặt</th>
            <th>Mã Khách Hàng (Customer ID)</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.CustomerId</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center">Chưa có đơn hàng nào.</td></tr>
        }
    </tbody>
</table>