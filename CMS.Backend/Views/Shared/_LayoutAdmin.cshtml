@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #212529;
            color: white;
            /* 🌟 ĐÃ SỬA: Ép thanh Sidebar luôn nổi lên trên cùng, chống bị chặn click */
            position: relative;
            z-index: 9999;
        }

            .sidebar a {
                color: #adb5bd;
                text-decoration: none;
                display: block;
                padding: 15px 20px;
                font-weight: 500;
            }

                .sidebar a:hover {
                    background-color: #343a40;
                    color: white;
                }

            .sidebar .active {
                background-color: #0d6efd;
                color: white;
            }

            .sidebar i {
                margin-right: 10px;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 sidebar p-0 shadow-lg">
                <div class="p-4 text-center border-bottom border-secondary">
                    <h4 class="text-white m-0"><i class="bi bi-shield-lock"></i> KongCMS ADMIN</h4>
                </div>

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>

                    <h6 class="text-secondary px-4 mt-4 mb-2 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Tin tức & Nội dung</h6>
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid"></i> Danh mục tin tức</a>
                    @* <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-post"></i> Quản lý Bài viết</a> *@
                    <a href="/Post/Index"><i class="bi bi-file-earmark-post"></i> Quản lý Bài viết</a>
                    <h6 class="text-secondary px-4 mt-4 mb-2 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Cửa hàng & Bán hàng</h6>
                    <a asp-controller="ProductCategory" asp-action="Index"><i class="bi bi-tags"></i> Danh mục sản phẩm</a>
                    <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Quản lý Sản phẩm</a>
                    <a asp-controller="Inventory" asp-action="Index"><i class="bi bi-receipt"></i> Quản lý tồn kho</a>
                    <a asp-controller="Customer" asp-action="Index"><i class="bi bi-person-badge"></i> Hồ sơ Khách hàng</a>
                    <a asp-controller="Order" asp-action="Index"><i class="bi bi-cart-check"></i> Quản lý Đơn hàng</a>
                    <a asp-controller="OrderDetail" asp-action="Index"><i class="bi bi-receipt"></i> Chi tiết đơn hàng</a>
                    <a asp-controller="Menu" asp-action="Index"><i class="bi bi-receipt"></i> Quản lý Menu (Header)</a>
                    <a asp-controller="Banner" asp-action="Index"><i class="bi bi-receipt"></i> Quản lý Banner (Trang chủ)</a>

                    <h6 class="text-secondary px-4 mt-4 mb-2 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Hệ thống</h6>
                    <a asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> Quản trị Thành viên</a>
                </div>
            </nav>

            <main class="col-md-9 p-0 bg-light">
                <div class="navbar navbar-expand bg-white shadow-sm px-4 py-3 d-flex justify-content-end align-items-center mb-4">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="text-dark me-3">
                            <i class="bi bi-person-circle text-primary"></i> Xin chào,
                            <strong class="text-dark">@User.FindFirst("FullName")?.Value</strong>
                            <span class="badge bg-danger ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </div>
                        <a class="btn btn-sm btn-outline-danger px-3" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </a>
                    }
                </div>

                <div class="px-4 pb-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>