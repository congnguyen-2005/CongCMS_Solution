<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar { min-height: 100vh; background-color: #212529; color: white; }
        .sidebar a { color: #adb5bd; text-decoration: none; display: block; padding: 15px 20px; font-weight: 500; }
        .sidebar a:hover { background-color: #343a40; color: white; }
        .sidebar .active { background-color: #0d6efd; color: white; }
        .sidebar i { margin-right: 10px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 sidebar p-0 shadow-lg">
                <div class="p-4 text-center border-bottom border-secondary">
                    <h4 class="text-white m-0"><i class="bi bi-shield-lock"></i> KongCMS ADMIN</h4>
                </div>
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid"></i> Quản lý Danh mục</a>
                    <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-post"></i> Quản lý Bài viết</a>
                    <a asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> Quản lý Thành viên</a>
                </div>
            </nav>

            <main class="col-md-9 p-4 bg-light">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>