@model CMS.Backend.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Tổng thể & Typography */
    body {
        background-color: #fcfcfc;
        font-family: 'Montserrat', sans-serif;
        color: #2b2b2b;
    }

    .luxury-heading {
        font-family: 'Playfair Display', serif;
        letter-spacing: 4px;
        color: #111111;
        position: relative;
        padding-bottom: 20px;
        text-transform: uppercase;
        font-weight: 600;
        font-size: 1.75rem;
    }

        .luxury-heading::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 45px;
            height: 2px;
            background-color: #c5a880; /* Màu vàng champagne sang trọng */
        }

    /* Thẻ Card - Tinh chỉnh viền và đổ bóng dịu nhẹ */
    .luxury-card {
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid #eee !important;
        border-radius: 4px; /* Bo góc cực nhẹ tạo sự tinh tế */
        background: #ffffff;
        overflow: hidden;
    }

        .luxury-card:hover {
            transform: translateY(-6px);
            border-color: #dcd6cd !important;
            box-shadow: 0 16px 32px rgba(0, 0, 0, 0.04) !important;
        }

    /* Hiệu ứng zoom ảnh điện ảnh (Cinematic Zoom) */
    .img-wrapper {
        overflow: hidden;
        position: relative;
        background-color: #f5f5f5;
    }

        .img-wrapper img {
            transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

    .luxury-card:hover .img-wrapper img {
        transform: scale(1.04);
    }

    /* Badge Danh mục tinh gọn */
    .luxury-category {
        color: #c5a880;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        display: inline-block;
    }

    /* Tiêu đề bài viết & Sản phẩm */
    .luxury-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #111111;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .luxury-title:hover {
            color: #c5a880;
        }

    /* Đoạn trích nội dung */
    .luxury-text {
        color: #6c757d;
        font-size: 0.88rem;
        line-height: 1.6;
        font-weight: 300;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Nút bấm tinh tế (Minimalist Luxury Button) */
    .luxury-btn {
        background-color: #111111;
        color: #ffffff;
        border: 1px solid #111111;
        border-radius: 2px;
        padding: 10px 20px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 500;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .luxury-btn:hover {
            background-color: transparent;
            color: #111111;
            border-color: #111111;
        }

    /* Biến thể nút bấm viền mảnh dành cho bài viết */
    .luxury-btn-outline {
        background-color: transparent;
        color: #111111;
        border: 1px solid #111111;
        padding: 8px 24px;
        width: auto;
    }

        .luxury-btn-outline:hover {
            background-color: #111111;
            color: #c5a880;
        }

    /* Kiểu dáng Giá tiền */
    .luxury-price {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: #111111;
        letter-spacing: 0.5px;
    }

    /* Nhãn đính kèm sản phẩm */
    .luxury-badge-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        background-color: #111111;
        color: #c5a880;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 4px 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        z-index: 2;
        border-radius: 2px;
    }

    /* Chân thẻ lịch lãm */
    .luxury-footer {
        background-color: transparent !important;
        border-top: 1px solid #f8f9fa !important;
        padding: 12px 24px;
        font-size: 0.8rem;
        color: #8c8c8c;
        font-weight: 300;
    }
</style>

<div class="container py-5">
    <h2 class="text-center luxury-heading mb-5">Bộ sưu tập nổi bật</h2>

    <div class="row g-4">
        @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
        {
            foreach (var prod in Model.FeaturedProducts)
            {
                <div class="col-6 col-md-4">
                    <div class="card h-100 border-0 luxury-card position-relative">

                        <span class="luxury-badge-tag">Mới về</span>

                        <div class="img-wrapper">
                            <img src="@prod.ImageUrl" class="card-img-top rounded-0" alt="@prod.Name" style="height: 320px; object-fit: cover;">
                        </div>

                        <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                            <div>
                                <div class="mb-2">
                                    <span class="luxury-category">@prod.CategoryProduct?.Name</span>
                                </div>
                                <a href="/Product/Details/@prod.Id" class="luxury-title d-block mb-2">@prod.Name</a>
                            </div>

                            <div class="mt-3">
                                <div class="luxury-price mb-3">
                                    @prod.Price.ToString("N0")<span style="font-size:0.85rem; font-family:'Montserrat'; font-weight:400; margin-left:2px;">đ</span>
                                </div>
                                <a href="/Product/Details/@prod.Id" class="btn luxury-btn">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-bag-x text-muted mb-3" style="font-size: 2.5rem; opacity: 0.4;"></i>
                <h5 class="text-muted fw-light" style="font-size:0.95rem; letter-spacing:1px;">Sản phẩm đang được cập nhật...</h5>
            </div>
        }
    </div>
</div>

<div class="container">
    <div style="height: 1px; background-color: #eee; width: 100%; margin: 40px 0;"></div>
</div>

<div class="container py-4 mb-5">
    <h2 class="text-center luxury-heading mb-5">Tin tức mới nhất</h2>

    <div class="row g-4">
        @if (Model.LatestPosts != null && Model.LatestPosts.Any())
        {
            foreach (var item in Model.LatestPosts)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 luxury-card">

                        <div class="img-wrapper">
                            <img src="@item.ImageUrl" class="card-img-top rounded-0" alt="@item.Title" style="height: 240px; object-fit: cover;">
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="mb-2">
                                    <span class="luxury-category">@item.Category?.Name</span>
                                </div>
                                <a href="/Post/Details/@item.Id" class="luxury-title d-block mb-3">@item.Title</a>
                                <div class="card-text luxury-text mb-4">
                                    @Html.Raw(item.Content)
                                </div>
                            </div>

                            <div>
                                <a href="/Post/Details/@item.Id" class="btn luxury-btn luxury-btn-outline">
                                    Đọc tiếp <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        <div class="card-footer luxury-footer d-flex align-items-center gap-2">
                            <i class="bi bi-calendar3"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-journal-x text-muted mb-3" style="font-size: 2.5rem; opacity: 0.4;"></i>
                <h5 class="text-muted fw-light" style="font-size:0.95rem; letter-spacing:1px;">Tin tức đang được biên tập...</h5>
            </div>
        }
    </div>
</div>