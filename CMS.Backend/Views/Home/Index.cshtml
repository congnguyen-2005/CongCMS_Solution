@model IEnumerable<CMS.data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-5">
    <h3 class="text-center mb-4 text-danger font-weight-bold">TIN TỨC MỚI NHẤT</h3>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover; background-color: #f8f9fa;">

                        <div class="card-body">
                            <span class="badge bg-primary mb-3">@item.Category.Name</span>

                            <h5 class="card-title fw-bold">@item.Title</h5>

                            <p class="card-text text-truncate text-muted">@item.Content</p>

                            <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm">Đọc tiếp</a>
                        </div>

                        <div class="card-footer bg-white text-muted small border-top-0">
                            <i class="far fa-clock"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Hệ thống đang cập nhật tin tức. Vui lòng quay lại sau!</p>
            </div>
        }
    </div>
</div>